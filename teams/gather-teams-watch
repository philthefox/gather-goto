#!/bin/zsh
zmodload zsh/datetime
# gather-teams-watch — runs gather-goto when a Microsoft Teams call starts (and optionally ends).
#
# A Teams call is recognised by Teams capturing the microphone (mic-watch, event-driven, no polling).
# Short blips are ignored: capture must last START_AFTER seconds to count as a call, and must be
# gone for END_AFTER seconds to count as ended (so muting in Teams does not end the "call").
# Settings: ~/.config/gather-goto/teams.conf   (shell syntax)
#   ON_START="customer"  gather-goto target when a call starts ("" = do nothing)
#   ON_END="desk"        gather-goto target when the call ended ("" = do nothing)
#   START_AFTER=3  END_AFTER=20
ON_START="customer"; ON_END="desk"; START_AFTER=3; END_AFTER=20
conf=~/.config/gather-goto/teams.conf; [[ -f $conf ]] && source $conf
share=${0:a:h}
goto=~/.local/bin/gather-goto
log() { print -r -- "$(date '+%F %T') $*" }
run() { [[ -z $1 ]] && return; log "gather-goto $1"; $goto ${=1} 2>&1 | while IFS= read -r l; do log "  $l"; done }

typeset -A active; in_call=0; start_at=0; end_at=0
coproc $share/mic-watch --watch com.microsoft.teams2
log "watching Teams microphone use (on start: '${ON_START}', on end: '${ON_END}')"
while true; do
  # block without waking up while nothing is pending; tick once a second while a timer runs
  if (( start_at || end_at )); then read -t 1 -p line || line=""; else read -p line || break; fi
  if [[ -n $line ]]; then
    ev=${line%% *}; id=${line#* }
    if [[ $ev == start ]]; then active[$id]=1; else unset "active[$id]"; fi
    if (( ${#active} )); then end_at=0; (( in_call || start_at )) || start_at=$EPOCHSECONDS
    else start_at=0; (( in_call && !end_at )) && end_at=$EPOCHSECONDS; fi
  fi
  if (( start_at && EPOCHSECONDS - start_at >= START_AFTER )); then start_at=0; in_call=1; log "Teams call started"; run "$ON_START"; fi
  if (( end_at && EPOCHSECONDS - end_at >= END_AFTER )); then end_at=0; in_call=0; log "Teams call ended"; run "$ON_END"; fi
done
log "mic-watch exited"; exit 1
